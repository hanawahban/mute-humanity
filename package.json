{
  "name": "sonific-8",
  "private": true,
  "version": "0.1.0",
  "description": "Melodic Earth Jukebox by Sonific-8: six NASA Earth Information Center maps played as music. NASA Space Apps 2026.",
  "license": "MIT",
  "homepage": "https://hanawahban.github.io/sonific-8/",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "placeholders": "node scripts/make-mock-data.mjs && python3 scripts/make_placeholders.py",
    "eic": "python3 scripts/download_eic.py"
  },
  "dependencies": {
    "@fontsource/fraunces": "^5.3.0",
    "d3-geo": "^3.1.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tone": "^15.1.22",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@types/d3-geo": "^3.1.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/topojson-client": "^3.1.5",
    "@vitejs/plugin-react": "^6.0.0",
    "jpeg-js": "^0.4.4",
    "typescript": "^5.9.0",
    "vite": "^8.0.0"
  },
  "aiDisclosure": "Parts of the code were written with Claude (Anthropic), an AI coding assistant, and reviewed by the team; the narration voice in public/voice is generated with the Kokoro text-to-speech model. See README, \"Use of AI (Super Intelligence)\"."
}
